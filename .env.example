# Copy this file to .env.local and fill it in. Never commit .env.local.
# Every value below is a placeholder. Nothing here is a working key.

# --- Web app (needed to run the site) ------------------------------------------
# Your Supabase project: Project Settings > API Keys. Use the publishable key
# (sb_publishable_...) or legacy anon key. It only allows what grants and Row Level
# Security permit. These have no NEXT_PUBLIC_ prefix: the browser never talks directly.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-project-key

# The public address of the site, without a trailing slash. Needed in production for
# the links in confirmation and password-reset emails, the sitemap and canonical URLs.
SITE_URL=http://localhost:3000

# --- Catalog import (needed only to run `npm run ingest`) ------------------------
# A direct Postgres connection string (Supabase: Project Settings, Database).
# This one can write to every table, so keep it out of the web app's environment.
DATABASE_URL=postgresql://postgres:your-password@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
# Optional: PEM text of a CA certificate to verify the database with, or set
# DATABASE_SSL_INSECURE=1 to skip verification (not recommended).
# DATABASE_SSL_CA=
# DATABASE_SSL_INSECURE=

# Open Library asks API users to identify themselves. Use a real contact address.
INGEST_CONTACT=you@example.com

# TMDB (movies and TV). Free keys are for non-commercial use only; see docs/DATA-SOURCES.md.
# TMDB_READ_ACCESS_TOKEN=
